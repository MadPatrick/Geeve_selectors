		-
			message: '#^Variable \$csvFileCandidates might not be defined\.$#'
			identifier: variable.undefined
			count: 2
			path: hoses/upload.php

		-
			message: '#^Strict comparison using \!\=\= between non\-empty\-string and '''' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: reports/artikelmarge/api/data.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(string\)\: bool\)\|null, ''strlen'' given\.$#'
			identifier: argument.type
			count: 1
			path: reports/brutoprijzen/api/data.php

		-
			message: '#^Call to function is_array\(\) with array\{tot\: int, melding\: string\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: shared/db.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: shared/db.php

		-
			message: '#^Offset ''melding'' on array\{tot\: int, melding\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: shared/db.php

		-
			message: '#^Offset ''tot'' on array\{tot\: int, melding\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 2
			path: shared/db.php

