# Alternatief: vul deze waarden in via Config in het hoofdmenu; ze worden dan
# versleuteld opgeslagen (.settings.enc) en hebben voorrang op dit bestand.
#
# Kopieer dit bestand naar ".env" (in de portal-root, naast dit bestand) en
# vul de echte waarden in. ".env" staat in .gitignore en mag NOOIT in git
# terechtkomen.
#
# 1 gedeelde SQL-login voor de Exact-database "005" (server GEEVE-SQL-2019),
# hergebruikt door alle subapps die met die database praten:
# - /stauff       - artikelgroep 67 (beugels)
# - /slangkaarten - Locatie op de picklijst (tabel CSPickITItemLocations)
#
# Zet deze inloggegevens dus 1x hier neer, niet los in stauff/.env of
# slangkaarten/.env - die apps laden dit bestand automatisch mee (zie
# inc/config.php in elke subapp).

EXACT_DB_HOST=GEEVE-SQL-2019
EXACT_DB_PORT=
EXACT_DB_NAME=005
EXACT_DB_USER=
EXACT_DB_PASSWORD=

# "yes" vertrouwt het (meestal zelfondertekende) SSL-certificaat van de
# SQL Server - nodig op vrijwel elke on-prem installatie, anders weigert
# ODBC Driver 18 de verbinding. Zet op "no" als de server een echt
# (CA-ondertekend) certificaat heeft.
EXACT_DB_TRUST_SERVER_CERT=yes
