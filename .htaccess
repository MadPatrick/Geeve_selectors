# Blokkeert browsertoegang tot dotfiles in de portal-root: ".env" en vooral
# ".settings.key" / ".settings.enc" (de versleutelde database-inloggegevens uit
# Config en hun sleutel). Dit blok moet blijven staan: zonder dit zijn die
# bestanden via de browser op te halen.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Geen mappenlijsten: een map zonder index.php geeft "Forbidden" in plaats van een
# lijst met bestanden en submappen.
Options -Indexes

# Korte adressen zonder mappen (zie shared/README.md, "Korte adressen"). Elk
# kort adres hoort bij een tegel-id in GEEVE_APP_URLS (shared/paths.php); die twee
# lijsten moeten gelijk blijven - tools/check-adressen.php controleert dat.
# Per app drie regels:
#  1. een bladwijzer op het oude adres (alleen GET van de pagina zelf) wordt
#     doorgestuurd naar het korte adres; API's en formulieren (POST) niet;
#  2. het korte adres zonder afsluitende "/" krijgt die erbij (nodig voor de
#     relatieve links in de app);
#  3. het korte adres wordt intern vertaald naar de echte map - de browser ziet die
#     map niet.
# 302 i.p.v. 301: een browser onthoudt een 301 voorgoed, dit blijft zo terug te draaien.
<IfModule mod_rewrite.c>
RewriteEngine On

# msp
RewriteCond %{THE_REQUEST} ^GET\s(\S*/)reports/msp/(index\.php)?(\?\S*)?\s
RewriteRule ^reports/msp/(index\.php)?$ %1msp/ [R=302,L]
RewriteRule ^msp$ %{REQUEST_URI}/ [R=302,L]
RewriteRule ^msp/(.*)$ reports/msp/$1 [L]

# inkoop-groep
RewriteCond %{THE_REQUEST} ^GET\s(\S*/)reports/inkoop\-groep/(index\.php)?(\?\S*)?\s
RewriteRule ^reports/inkoop\-groep/(index\.php)?$ %1inkoop-groep/ [R=302,L]
RewriteRule ^inkoop-groep$ %{REQUEST_URI}/ [R=302,L]
RewriteRule ^inkoop-groep/(.*)$ reports/inkoop-groep/$1 [L]

# productiviteit
RewriteCond %{THE_REQUEST} ^GET\s(\S*/)reports/productiviteit/(index\.php)?(\?\S*)?\s
RewriteRule ^reports/productiviteit/(index\.php)?$ %1productiviteit/ [R=302,L]
RewriteRule ^productiviteit$ %{REQUEST_URI}/ [R=302,L]
