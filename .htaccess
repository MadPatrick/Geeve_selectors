RewriteRule ^stickers/productie/(index\.php)?$ %1stickers-productie/ [R=302,L]
RewriteRule ^stickers-productie$ %{REQUEST_URI}/ [R=302,L]
RewriteRule ^stickers-productie/(.*)$ stickers/productie/$1 [L]

# stickers-artikel
RewriteCond %{THE_REQUEST} ^GET\s(\S*/)stickers/artikel/(index\.php)?(\?\S*)?\s
RewriteRule ^stickers/artikel/(index\.php)?$ %1stickers-artikel/ [R=302,L]
RewriteRule ^stickers-artikel$ %{REQUEST_URI}/ [R=302,L]
