# Blokkeert browsertoegang tot dotfiles in de portal-root: ".env" en vooral
# ".settings.key" / ".settings.enc" (de versleutelde database-inloggegevens uit
# Config en hun sleutel). Dit blok moet blijven staan: zonder dit zijn die
# bestanden via de browser op te halen.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Cache: CSS, JS en afbeeldingen elke keer bij de server navragen (304 als ze niet veranderd zijn),
# zodat na een git pull meteen de nieuwe versie geladen wordt - ook van bestanden zonder ?v=, zoals
# shared/tokens.css (via @import in shared/style.css) en de logo's. Werkt alleen met mod_headers.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|gif|svg|ico|webp)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
