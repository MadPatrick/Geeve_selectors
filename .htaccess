# stickers-slanglabels
RewriteCond %{THE_REQUEST} ^GET\s(\S*/)stickers/slanglabels/(index\.php)?(\?\S*)?\s
RewriteRule ^stickers/slanglabels/(index\.php)?$ %1stickers-slanglabels/ [R=302,L]
RewriteRule ^stickers-slanglabels$ %{REQUEST_URI}/ [R=302,L]
RewriteRule ^stickers-slanglabels/(.*)$ stickers/slanglabels/$1 [L]

# Overal: ".../index.php" in de adresbalk wordt ".../" (alleen GET).
RewriteCond %{THE_REQUEST} ^GET\s(\S*/)index\.php(\?\S*)?\s
RewriteRule ^(.*/)?index\.php$ %1 [R=302,L]
</IfModule>
