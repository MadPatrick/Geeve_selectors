# Blokkeert browsertoegang tot dotfiles in de portal-root: ".env" en vooral
# ".settings.key" / ".settings.enc" (de versleutelde database-inloggegevens uit
# Config en hun sleutel). Dit blok moet blijven staan: zonder dit zijn die
# bestanden via de browser op te halen.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Documentatie, scripts en werkbestanden staan in git naast de apps, maar zijn niet voor de browser bedoeld (README's,
# beheer-/auditscripts, SQL, losse CSV/Excel-lijsten, licentieteksten). De apps lezen ze waar nodig zelf van schijf
# (bijv. reports/msp/sql/msp_query.sql) of bieden een download via een eigen .php (bijv. hoses/download.php).
# PDF's in docs/ blijven wel bereikbaar. tools/ en tmp/ hebben daarnaast een eigen .htaccess die alles afsluit.
<FilesMatch "(?i)\.(md|sh|py|mjs|sql|csv|txt|xlsx|xls)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Compressie: Debian comprimeert alleen html/css/js standaard, application/json niet (zoek- en data-API's). Hier alles
# wat tekst is expliciet aan: scheelt 70-85% verkeer op de grote scripts (selector.js, offerte.js, xlsx). Afbeeldingen
# (jpg/png) zijn al gecomprimeerd en blijven buiten beeld. Werkt alleen met mod_deflate.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache: CSS, JS en afbeeldingen elke keer bij de server navragen (304 als ze niet veranderd zijn),
# zodat na een git pull meteen de nieuwe versie geladen wordt - ook van bestanden zonder ?v=, zoals
# de logo's en het favicon. Werkt alleen met mod_headers.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|gif|svg|ico|webp)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Uitzondering: adressen met ?v=<wijzigingsdatum> (geeveAssetHref(), assetVersion(), achtergrondUrl()) krijgen bij een
    # wijziging van het bestand vanzelf een ander adres, dus die mogen een jaar in de browser blijven staan zonder
    # navraag bij de server. Een <If> wordt na de regel hierboven verwerkt en wint dus.
    <If "%{QUERY_STRING} =~ /(^|&)v=[0-9]+(&|$)/">
        <FilesMatch "\.(css|js|png|jpe?g|gif|svg|ico|webp)$">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </FilesMatch>
    </If>
</IfModule>
