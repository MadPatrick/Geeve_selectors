# Kopieer dit bestand naar ".env" en vul de echte waarden in.
# ".env" staat in .gitignore en mag NOOIT in git terechtkomen.

DB_HOST=GEEVE-SQL-2019
DB_PORT=
DB_NAME=Slangkaarten
DB_USER=
DB_PASSWORD=

# "yes" vertrouwt het (meestal zelfondertekende) SSL-certificaat van de
# SQL Server - nodig op vrijwel elke on-prem installatie, anders weigert
# ODBC Driver 18 de verbinding. Zet op "no" als de server een echt
# (CA-ondertekend) certificaat heeft.
DB_TRUST_SERVER_CERT=yes

# Tweede, aparte verbinding: de Exact-database "005" (zelfde server, ander
# doel) voor de artikellocatie op de picklijst (tabel CSPickITItemLocations,
# zie findArtikelLocatie() in index.php) - zelfde Exact-database als /stauff
# gebruikt voor artikelgroep 67, maar met eigen inloggegevens/env-vars zodat
# dit niet botst met DB_USER/DB_PASSWORD hierboven. Zonder deze vars blijft
# de Locatie-kolom op de picklijst gewoon een streepje.
EXACT_DB_HOST=GEEVE-SQL-2019
EXACT_DB_PORT=
EXACT_DB_NAME=005
EXACT_DB_USER=
EXACT_DB_PASSWORD=
EXACT_DB_TRUST_SERVER_CERT=yes
