# Kopieer dit bestand naar ".env" en vul de echte waarden in.
# ".env" staat in .gitignore en mag NOOIT in git terechtkomen.

DB_HOST=GEEVE-SQL-2019
DB_PORT=
DB_NAME=Slangkaarten
DB_USER=
DB_PASSWORD=

# "yes" vertrouwt het (meestal zelfondertekende) SSL-certificaat van de
# SQL Server - nodig op vrijwel elke on-prem installatie, anders weigert
# ODBC Driver 18 de verbinding. Zet op "no" als de server een echt
# (CA-ondertekend) certificaat heeft.
DB_TRUST_SERVER_CERT=yes

# De Locatie-kolom op de picklijst gebruikt een TWEEDE verbinding, naar de
# Exact-database "005" (tabel CSPickITItemLocations) - dezelfde database en
# hetzelfde SQL-account als /stauff (artikelgroep 67). Die inloggegevens
# (EXACT_DB_*) staan niet hier, maar centraal in de portal-root .env - zie
# ../.env.example (1 map hoger dan slangkaarten/). Zonder die root-.env
# blijft de Locatie-kolom gewoon een streepje, de rest werkt normaal door.
