#!/usr/bin/php
<?php

declare(strict_types=1);

/**
 * Hulpscript voor het inloggen op de Config-pagina met een serveraccount.
 *
 * Wordt als root uitgevoerd via sudo (zie geeve-auth.sudoers) en controleert of
 *   1. de gebruiker bestaat en lid is van de groep "sudo" (aanvullend of als hoofdgroep), en
 *   2. het wachtwoord klopt met de hash in /etc/shadow.
 * Invoer via stdin: regel 1 = gebruikersnaam, regel 2 = wachtwoord (niet als argument, dus niet
 * zichtbaar in de procestabel). Exitcode 0 = geslaagd, 1 = geweigerd. Er wordt niets uitgevoerd
 * met de gebruikersnaam of het wachtwoord behalve de controle zelf.
 */
function geeveAuthVerify(
    string $user,
    string $password,
    string $shadowFile = '/etc/shadow',
    string $passwdFile = '/etc/passwd',
    string $groupFile = '/etc/group',
    string $adminGroup = 'sudo'
): bool {
    if (preg_match('/^[a-z_][a-z0-9_.-]{0,31}$/', $user) !== 1 || $password === '' || strlen($password) > 256) {
        return false;
    }

    $gid = null;
    $members = [];
    foreach (@file($groupFile, FILE_IGNORE_NEW_LINES) ?: [] as $line) {
        $f = explode(':', $line);
        if (($f[0] ?? '') === $adminGroup) {
            $gid = $f[2] ?? null;
            $members = array_filter(explode(',', $f[3] ?? ''));
        }
    }
    if ($gid === null) {
        return false;
    }

    $exists = false;
    $isAdmin = in_array($user, $members, true);
    foreach (@file($passwdFile, FILE_IGNORE_NEW_LINES) ?: [] as $line) {
        $f = explode(':', $line);
        if (($f[0] ?? '') === $user) {
            $exists = true;
            if (($f[3] ?? null) === $gid) {
                $isAdmin = true;
            }
        }
    }
    if (!$exists || !$isAdmin) {
        return false;
    }

    $hash = null;
    foreach (@file($shadowFile, FILE_IGNORE_NEW_LINES) ?: [] as $line) {
        $f = explode(':', $line);
        if (($f[0] ?? '') === $user) {
            $hash = $f[1] ?? '';
        }
    }
    // Leeg, uitgeschakeld ("!", "*") of vergrendeld account: nooit toelaten.
    if ($hash === null || $hash === '' || $hash[0] === '!' || $hash[0] === '*') {
        return false;
    }

    $calculated = crypt($password, $hash);
    return is_string($calculated) && strlen($calculated) > 13 && hash_equals($hash, $calculated);
}

// Alleen uitvoeren als dit script direct wordt gestart (niet bij include in een test).
if (PHP_SAPI === 'cli' && isset($_SERVER['SCRIPT_FILENAME']) && realpath($_SERVER['SCRIPT_FILENAME']) === __FILE__) {
    $input = (string) stream_get_contents(STDIN, 600);
    $parts = explode("\n", $input, 2);
    $user = trim($parts[0] ?? '');
    $password = rtrim($parts[1] ?? '', "\r\n");

    if (geeveAuthVerify($user, $password)) {
        exit(0);
    }
    sleep(1); // vertraagt het raden van wachtwoorden
    exit(1);
}
